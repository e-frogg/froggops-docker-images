#!/usr/bin/env bash
set -euo pipefail

ADMIN_SOCKET="${FOPS_ROUTER_ADMIN_SOCKET:-/run/caddy/admin.sock}"

usage() {
	cat >&2 <<'USAGE'
Usage:
  fops-routerctl status
  fops-routerctl put-stack <project> <instance> <json-payload>
  fops-routerctl delete-stack <project> <instance>
USAGE
}

urlencode() {
	local input="$1"
	local output=""
	local char
	local hex
	local i

	for ((i = 0; i < ${#input}; i++)); do
		char="${input:i:1}"
		case "$char" in
			[a-zA-Z0-9.~_-])
				output+="$char"
				;;
			*)
				printf -v hex '%%%02X' "'$char"
				output+="$hex"
				;;
		esac
	done

	printf '%s' "$output"
}

admin_request() {
	local method="$1"
	local path="$2"
	local payload="${3-}"
	local command=(
		curl
		-s
		-S
		-f
		--unix-socket "$ADMIN_SOCKET"
		-H 'Accept: application/json'
	)

	if [[ "$method" != "GET" ]]; then
		command+=(-X "$method")
	fi

	if [[ -n "$payload" ]]; then
		command+=(-H 'Content-Type: application/json' -d "$payload")
	fi

	command+=("http://localhost${path}")
	"${command[@]}"
}

command="${1-}"
case "$command" in
	status)
		if [[ "$#" -ne 1 ]]; then
			usage
			exit 64
		fi
		admin_request GET /fops-router/v1/status
		;;
	put-stack)
		if [[ "$#" -ne 4 ]]; then
			usage
			exit 64
		fi
		project="$(urlencode "$2")"
		instance="$(urlencode "$3")"
		admin_request PUT "/fops-router/v1/stacks/${project}/${instance}" "$4"
		;;
	delete-stack)
		if [[ "$#" -ne 3 ]]; then
			usage
			exit 64
		fi
		project="$(urlencode "$2")"
		instance="$(urlencode "$3")"
		admin_request DELETE "/fops-router/v1/stacks/${project}/${instance}"
		;;
	*)
		usage
		exit 64
		;;
esac
